# Required for Phase 2 apply/ingestion. Do not commit an actual .env file.
# Use the hostname or base URL supplied by TigerGraph Savanna/Community Edition.
TIGERGRAPH_HOST=https://your-tigergraph-host
TIGERGRAPH_GRAPH=FraudCommand

# Provide exactly the authentication mechanism configured for the deployment.
# Username/password are appropriate only when enabled by that deployment.
TIGERGRAPH_USERNAME=
TIGERGRAPH_PASSWORD=

# A least-privilege RESTPP or query secret, if the deployment uses token auth.
TIGERGRAPH_SECRET=

# Optional: the configured TigerGraph MCP endpoint, after MCP integration begins.
TIGERGRAPH_MCP_URL=

# Model Gateway
GROQ_API_KEY=<set-secret>

# Cache & Ephemeral State
REDIS_URL=<set-secret>
REDIS_DATABASE=<database-name>

# Durable Relational Storage
SUPABASE_URL=<project-url>
SUPABASE_PUBLISHABLE_KEY=<set-secret>
SUPABASE_DB_PASSWORD=<set-secret>
